          {
            "group": "Spotlight",
            "pages": [
              "guides/citations",
              "guides/prompts",
              "guides/topics",
              "guides/search-queries",
              "guides/sentiment",
              "guides/agent-analytics"
            ]
          },
          {
            "group": "Battlemap",
            "pages": [
              "guides/competitors",
              "guides/source-intelligence"
            ]
          },
          {
            "group": "Elevate",
            "pages": [
              "guides/elevate"
            ]
          },
          {
            "group": "Analyzer",
            "pages": [
              "guides/audit",
              "guides/health",
              "guides/pages"
            ]
          },
          {
            "group": "Planning",
            "pages": [
              "guides/marketing-plan"
            ]
          },
          {
            "group": "Account and team",
            "pages": [
              "guides/websites",
              "guides/workspaces",
              "guides/settings",
              "guides/api-keys"
            ]
          },
          {
            "group": "Free tools",
            "pages": [
              "guides/free-tools"
            ]
          },
          {
            "group": "MCP server",
            "pages": [
              "guides/mcp/overview",
              "guides/mcp/setup",
              "guides/mcp/tools"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoints",
            "openapi": "/api-reference/openapi.json"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "/",
